{
  "name": "kimi-cli-desktop",
  "productName": "Kimi Code Desktop",
  "version": "1.0.0-beta.1",
  "description": "Unofficial desktop shell for the Kimi Code CLI — run interactive Kimi Code sessions in tabs, resume previous sessions, and drive the agent from one place. Not affiliated with Moonshot AI.",
  "main": "main.js",
  "author": "Kimi Code Desktop contributors",
  "license": "MIT",
  "homepage": "https://github.com/grafizum/kimi-cli-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/grafizum/kimi-cli-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/grafizum/kimi-cli-desktop/issues"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/smoke-test.js",
    "e2e": "node scripts/e2e-test.js",
    "e2e:wsl": "node scripts/e2e-wsl-test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kimicodedesktop.app",
    "productName": "Kimi Code Desktop",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Kimi-Code-Desktop-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "Kimi-Code-Desktop-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Kimi-Code-Desktop-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "Kimi-Code-Desktop-Setup-${version}-${arch}.${ext}"
    }
  }
}
